# Force 32-bit Debian architecture required by the CheerpX engine
FROM --platform=linux/386 docker.io/i386/debian:buster
ARG DEBIAN_FRONTEND=noninteractive

# Point APT to the archived mirrors (Buster is EOL)
RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" \
  > /etc/apt/sources.list && \
  echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" \
  >> /etc/apt/sources.list

# Run base system alignment updates
RUN apt-get clean && apt-get update && apt-get -y upgrade

# Install X11, Openbox, Falkon Browser, and baseline GUI tools
RUN apt-get -y install --no-install-recommends \
    xserver-xorg-core \
    x11-xserver-utils \
    xinit \
    openbox \
    falkon \
    ca-certificates \
    fonts-croscore \
    dbus-x11

# Set up the expected WebVM user execution environment
RUN useradd -m user && echo "user:password" | chpasswd
COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="C.UTF-8"
RUN echo 'root:password' | chpasswd

# WebVM hooks directly into DISPLAY :0
ENV DISPLAY=:0

# Configure Openbox to launch Falkon automatically on startup
RUN mkdir -p /home/user/.config/openbox \
    && echo "dbus-launch falkon &" > /home/user/.config/openbox/autostart \
    && chmod +x /home/user/.config/openbox/autostart \
    && chown -R user:user /home/user/.config

CMD ["openbox-session"]
